# Authenticated application role. Must not be neondb_owner and must not have BYPASSRLS.
RACK_DATABASE_URL=postgresql://authenticated-runtime:password@host/database

# Dedicated login role with membership in rack_workflow only. Workflow steps set one Rack run ID transaction-locally; RLS limits this connection to that reliable check.
RACK_WORKFLOW_DATABASE_URL=postgresql://workflow-runtime:password@host/database

# Dedicated login role with membership in rack_retention only.
RACK_RETENTION_DATABASE_URL=postgresql://retention-runtime:password@host/database

# Neon Auth/JWKS configuration for the same branch as the database.
NEON_AUTH_JWKS_URL=https://example.neon.tech/.well-known/jwks.json
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=

# Vercel sends this as Authorization: Bearer <secret> to cron routes.
CRON_SECRET=replace-with-a-random-secret-of-at-least-16-characters
