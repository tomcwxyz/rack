# Authenticated application role. Must not be neondb_owner and must not have BYPASSRLS.
RACK_DATABASE_URL=postgresql://authenticated-runtime:password@host/database

# Dedicated login role with membership in rack_workflow only. Workflow steps set one Rack run ID transaction-locally; RLS limits this connection to that reliable check.
RACK_WORKFLOW_DATABASE_URL=postgresql://workflow-runtime:password@host/database

# Dedicated login role with membership in rack_retention only.
RACK_RETENTION_DATABASE_URL=postgresql://retention-runtime:password@host/database

# Deployment-owned provider-neutral model aliases. Prices are micro-USD per million tokens.
# Production parsing requires at least two distinct managed providerId values.
RACK_MODEL_REGISTRY_JSON={"schemaVersion":"0.1","models":[{"alias":"generator","providerId":"provider-one","modelId":"model-a","connection":"managed","capabilities":["generate","judge"],"pricing":{"inputMicrousdPerMillionTokens":1000000,"outputMicrousdPerMillionTokens":4000000},"limits":{"maxOutputTokens":4096}},{"alias":"judge","providerId":"provider-two","modelId":"model-b","connection":"managed","capabilities":["judge"],"pricing":{"inputMicrousdPerMillionTokens":2000000,"outputMicrousdPerMillionTokens":8000000},"limits":{"maxOutputTokens":2048}}]}

# Defaults are copied into a workspace's owner-scoped limit row the first time preflight is used.
# Later execution will update spent/reserved values transactionally; preflight never reserves or spends.
RACK_EVALUATION_LIMITS_JSON={"hardBudgetMicrousd":100000000,"perRunCapMicrousd":10000000,"concurrencyLimit":2,"maxProviderAttemptsPerCall":3}

# Neon Auth/JWKS configuration for the same branch as the database.
NEON_AUTH_JWKS_URL=https://example.neon.tech/.well-known/jwks.json
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=

# Vercel sends this as Authorization: Bearer <secret> to cron routes.
CRON_SECRET=replace-with-a-random-secret-of-at-least-16-characters
