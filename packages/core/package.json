{
  "name": "@rack/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./build": { "types": "./dist/build.d.ts", "default": "./dist/build.js" },
    "./node": { "types": "./dist/node.d.ts", "default": "./dist/node.js" },
    "./starter": { "types": "./dist/starterImports.d.ts", "default": "./dist/starterImports.js" },
    "./starter-node": { "types": "./dist/starterNode.d.ts", "default": "./dist/starterNode.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm typecheck && pnpm test",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@rack/schemas": "workspace:*",
    "@rack/starter": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
